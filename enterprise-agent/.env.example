# Copy to .env for manual setup, or run: uv run enterprise-agent setup
# This is the optional LOCAL self-host profile. Shared-service owners use
# .env.shared.example or setup --shared; website users do not need any env file.
# Use your own organization/app registrations. Never paste real secrets into this file.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
RUNTIME_MODE=gemini
STORAGE_BACKEND=database

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# See docs/SELF_HOST_SETUP.md for the two Entra app registrations.
AUTH_ENABLED=true
AZURE_TENANT_ID=TO_BE_FILLED_LATER
AZURE_CLIENT_ID=TO_BE_FILLED_LATER
AZURE_CLIENT_SECRET=
ENTRA_API_AUDIENCE=TO_BE_FILLED_LATER
ENTRA_REQUIRED_SCOPES=access_as_user
AUTH_ALLOWED_TENANT_IDS=TO_BE_FILLED_LATER
ENTRA_ALLOWED_CLIENT_IDS=TO_BE_FILLED_LATER
ENTRA_SPA_CLIENT_ID=TO_BE_FILLED_LATER
ENTRA_SPA_REDIRECT_URI=http://localhost:8000/auth/callback

# Delegated reads only. Each organization's administrator must enable/consent Work IQ.
ENABLED_TOOL_GROUPS=workiq_read,local_read,artifact_generation
WORKIQ_MCP_URL=https://workiq.svc.cloud.microsoft/mcp
WORKIQ_SCOPE=api://workiq.svc.cloud.microsoft/WorkIQAgent.Ask
REQUIRE_WRITE_APPROVAL=true

# Optional services stay disabled until configured separately.
SPEECH_PROVIDER=disabled
