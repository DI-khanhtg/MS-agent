# Owner-only server configuration. Users sign in on the website; they need no .env.
# Generate a private file: enterprise-agent setup --shared --output .env.shared
DEPLOYMENT_MODE=shared
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=https://agent.example.com
ALLOWED_HOSTS=agent.example.com,localhost,127.0.0.1
RUNTIME_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AUTH_ENABLED=true
AUTH_TENANT_MODE=organizations
AZURE_TENANT_ID=TO_BE_FILLED_LATER
AZURE_CLIENT_ID=TO_BE_FILLED_LATER
AZURE_CLIENT_SECRET=
ENTRA_API_AUDIENCE=TO_BE_FILLED_LATER
ENTRA_REQUIRED_SCOPES=access_as_user
ENTRA_ALLOWED_CLIENT_IDS=TO_BE_FILLED_LATER
ENTRA_SPA_CLIENT_ID=TO_BE_FILLED_LATER
ENTRA_SPA_REDIRECT_URI=https://agent.example.com/auth/callback
# Empty admits work/school organizations with valid consent/tokens for this API.
# Set comma-separated tenant UUIDs to restrict enrollment to approved organizations.
AUTH_ALLOWED_TENANT_IDS=
STORAGE_BACKEND=database
# SQLite + persistent volume is a single-instance pilot. For PostgreSQL install production extra.
DATABASE_URL=
ENABLED_TOOL_GROUPS=workiq_read,artifact_generation
DOCUMENT_UPLOADS_ENABLED=false
# To enable private uploads: true above, add local_read to ENABLED_TOOL_GROUPS,
# or generate the server profile with setup --shared --uploads.
SHARED_REQUESTS_PER_MINUTE=600
SHARED_CHAT_REQUESTS_PER_MINUTE=120
SHARED_MAX_CONCURRENT_CHATS=8
SHARED_MAX_CONCURRENT_PER_USER=2
RATE_LIMIT_PER_MINUTE=60
REQUIRE_WRITE_APPROVAL=true
SPEECH_PROVIDER=disabled
WEB_CONCURRENCY=1
