# Build from enterprise-agent/. Runtime jobs must use the verified SandboxClient policy.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    HOME=/work \
    TMPDIR=/work

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
       python3 python3-venv python3-pip python3-uno \
       libreoffice-writer libreoffice-calc libreoffice-impress \
       fonts-dejavu-core fonts-liberation ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv --system-site-packages /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir uv==0.11.32

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN /opt/venv/bin/uv sync --frozen --no-dev --extra documents --python /usr/bin/python3 \
    && useradd --uid 10001 --create-home worker \
    && mkdir -p /work && chown 10001:10001 /work && chmod 700 /work

WORKDIR /work
USER 10001:10001
ENTRYPOINT ["/opt/venv/bin/python", "-m", "enterprise_agent.tools.document_worker"]
